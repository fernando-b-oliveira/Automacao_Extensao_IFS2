{
  "manifest_version": 3,
  "name": "Web Data Bridge Connector",
  "version": "1.0.0",
  "description": "Extensão genérica e modular para extração de dados DOM e envio para API local de persistência.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
